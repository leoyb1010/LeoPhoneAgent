.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store

# Environment and secrets
.env
.env.*

# App Store Connect API keys
fastlane/.env
fastlane/appstore-keys/

# Claude Code
.claude/

# Temporary patches
deps/*.patch

# Alpine downloadable assets (ISO, rootfs, qcow2, etc.)

# iSH build outputs
deps/libs/
deps/include/
deps/resources/
deps/ish/build-ios/
deps/ish/build-native/
deps/.cache/

# FFmpeg source (downloaded by build_ffmpeg.sh). Note the trailing -6.1.2:
# a bare `deps/ffmpeg-*/` also swallowed deps/ffmpeg-patch/, which is hand
# written source that the build needs and must stay tracked.

# FFmpeg framework build products (regenerated by deps/build_ffmpeg.sh).
deps/frameworks/

# Xcode debugger state (breakpoints) — personal dev state, never track
xcshareddata/xcdebugger/

# Build-time generated Swift (from ProviderCustomization.xcconfig); regenerated each build
src/ios/Generated/
# Local provider customization may contain private OAuth identifiers.
src/ios/Configs/ProviderCustomization.xcconfig

# Debug-only skill assets staged by scripts/gen_debug_skill_android.sh from
# .claude/skills/debug-server/; regenerated on every debug build.

# ── Build artifacts produced by deps/ scripts — never commit binaries ──
# These are generated, not authored: rebuild them from source instead of
# tracking them (tracked binaries also leak the build machine's paths via
# debug symbols). See deps/build_proot.sh, deps/build_lame.sh,
# deps/prepare_alpine_rootfs.sh and docs for the build order.

# LAME autotools output (./configure writes absolute build paths into these)

# LeoAgentDesktop(vendored Cindy 分支)的依赖与构建产物

# LeoAgentDesktop vendored CLI 二进制(可重新下载;GitHub 单文件上限 100MB)
src/mac/leoagent/__pycache__/
__pycache__/
