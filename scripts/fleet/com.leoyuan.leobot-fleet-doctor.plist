<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 只装在 mini(中继所在机器)。告警走与资料库巡检同一条 ntfy 通道。 -->
  <key>Label</key><string>com.leoyuan.leobot-fleet-doctor</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Homebrew python3:launchd 下 /usr/bin/python3 没有外接盘(restic 仓库)的访问授权,会卡在 TCC 上 -->
    <string>/opt/homebrew/bin/python3</string>
    <string>-I</string>
    <string>__HOME__/Library/Application Support/LeoBot-fleet/LeoFleetDoctor.py</string>
    <string>--monitor</string>
    <string>__HOME__/Library/Application Support/LeoBot-fleet/state</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NTFY_URL</key><string>http://127.0.0.1:8095/bubu-ops</string>
    <key>NTFY_TOKEN_FILE</key><string>__HOME__/.config/bubu/ntfy-token</string>
    <key>LEO_RELAY_RESTIC_REPO</key><string>/Volumes/Leo-bubu/Mac-Offload/Backups/leo-relay-restic</string>
    <key>LEO_RELAY_RESTIC_PASSWORD_FILE</key><string>__HOME__/.config/leo-relay/restic-password</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>300</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Application Support/LeoBot-fleet/doctor.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Application Support/LeoBot-fleet/doctor.err.log</string>
</dict>
</plist>
