    "to": "/** Convert a raw monitor status phrase only at the presentation boundary. */\nexport function displayMonitorEta(raw: string): string {\n  const duration = (value: string) => value.replace(/(\\d+)d\\b/g, \"$1 天\").replace(/(\\d+)h\\b/g, \"$1 小时\").replace(/(\\d+)m\\b/g, \"$1 分钟\").replace(/(\\d+)s\\b/g, \"$1 秒\");\n  if (raw === \"due now\" || raw === \"now\") return \"现在到期\";\n  if (raw.startsWith(\"in \")) return `${duration(raw.slice(3))}后`;\n  if (raw.startsWith(\"overdue by \")) return `已逾期 ${duration(raw.slice(11))}`;\n  if (raw.endsWith(\" ago\")) return `${duration(raw.slice(0, -4))}前`;\n  return duration(raw);\n}\nexport function formatMonitorEtaLabel(nextCheckAt: MonitorDate, now: MonitorDate = new Date()): string {\n  return displayMonitorEta(formatMonitorEta(nextCheckAt, now));\n}",
