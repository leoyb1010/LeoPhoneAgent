#!/bin/sh
# Compatibility shim for the pre-rebrand command name.
#
# The bundled CLI is now /usr/local/bin/leophoneagent-mcp-cli with its Python
# under /usr/local/lib/leophoneagent-mcp-cli. Older sessions, saved skills and
# shell history still invoke `minis-mcp-cli`, and an install that predates the
# rename leaves the old wrapper on disk, so keep this name working instead of
# failing with "command not found".
exec /usr/local/bin/leophoneagent-mcp-cli "$@"
