        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치 이름은 iCloud 동기화 영역에 있는 다른 장치로 브로드캐스트됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
