    "%@ and its saved password will be removed from this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and its saved password will be removed from this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 及其已存密码将从本机移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 及其已存密碼將從本機移除。"
          }
        }
      }
    },
    "%@ sign-in has expired. Please sign in again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 登录已过期，请重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 登入已過期，請重新登入。"
          }
        }
      }
    },
    "A privacy-aware task snapshot is stored in the LeoBot App Group. Live Activity content follows Task Status Privacy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务快照(已按隐私设置处理)存在 LeoBot 的 App Group 里;实时活动显示什么跟随「任务状态隐私模式」。"
          }
        }
      }
    },
    "A tool step failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一步工具调用失败了"
          }
        }
      }
    },
    "API keys and tokens are stored in the iOS Keychain; provider configuration may also sync through your iCloud account when iCloud Sync is enabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥和令牌存在 iOS 钥匙串里;开启 iCloud 同步后,AI 服务商配置也会经你的 iCloud 账户同步"
          }
        }
      }
    },
    "API keys are stored in the iOS Keychain and can sync through iCloud Keychain; sign-in tokens stay on this device only. Provider configuration may also sync through your iCloud account when iCloud Sync is enabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key 保存在 iOS 钥匙串，可随 iCloud 钥匙串同步；登录凭证只保留在本机。开启 iCloud 同步后，供应商配置也可能通过你的 iCloud 账户同步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key 保存在 iOS 鑰匙圈，可隨 iCloud 鑰匙圈同步；登入憑證只保留在本機。開啟 iCloud 同步後，供應商設定也可能透過你的 iCloud 帳號同步"
          }
        }
      }
    },
    "Access to this folder was revoked. Remove this mount and pick the folder again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to this folder was revoked. Remove this mount and pick the folder again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件夹的访问权限已被收回。请移除挂载后重新选择文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個資料夾的存取權限已被收回。請移除掛載後重新選擇資料夾。"
          }
        }
      }
    },
    "Antigravity has been retired. Add a Gemini API key from Google AI Studio instead, then delete this provider.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Antigravity 已下线。请改为添加 Google AI Studio 的 Gemini API Key，然后删除此供应商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Antigravity 已下線。請改為新增 Google AI Studio 的 Gemini API Key，然後刪除此供應商。"
          }
        }
      }
    },
    "Approved automatically (full auto), no prompt shown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全自动放行,没有弹确认"
          }
        }
      }
    },
    "Ask me for a folder and organize the documents inside.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让我选一个文件夹,把里面的文档整理好。"
          }
        }
      }
    },
    "Ask When Used": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用到时询问"
          }
        }
      }
    },
    "Ask you to pick a folder or file": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请你选择文件夹或文件"
          }
        }
      }
    },
    "Attach media to a task": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给任务附上图片或视频"
          }
        }
      }
    },
    "Attach recorded audio": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附上录音"
          }
        }
      }
    },
    "Attempts to start the on-device Linux environment again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动本机的 Linux 环境。"
          }
        }
      }
    },
    "Audio is processed by the configured transcription path. The transcript enters the current conversation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频按你设置的转写方式处理,转写结果进入当前对话。"
          }
        }
      }
    },
    "Audio submitted for transcription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "送去转写的音频"
          }
        }
      }
    },
    "Auto-approved (full auto)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全自动:已自动批准"
          }
        }
      }
    },
    "Back up app data": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份 App 数据"
          }
        }
      }
    },
    "Background Processing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台处理"
          }
        }
      }
    },
    "Browse app files": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览 App 里的文件"
          }
