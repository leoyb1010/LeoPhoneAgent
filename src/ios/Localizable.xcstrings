    "Exports provider configuration including API key. Share via AirDrop, Messages, etc. to set up on another device.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiert die Anbieterkonfiguration einschließlich API-Schlüssel. Teilen Sie per AirDrop, Nachrichten usw. zur Einrichtung auf einem anderen Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exports provider configuration including API key. Share via AirDrop, Messages, etc. to set up on another device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte la configuration du fournisseur incluant la clé API. Partagez via AirDrop, Messages, etc. pour configurer un autre appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーを含むプロバイダー設定をエクスポートします。AirDrop やメッセージなどで別のデバイスに共有できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키를 포함한 제공자 구성을 내보냅니다. AirDrop, 메시지 등으로 다른 기기에 설정하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортирует конфигурацию провайдера, включая API-ключ. Поделитесь через AirDrop, Сообщения и т. п., чтобы настроить на другом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出服务商配置（包含 API 密钥）。通过 AirDrop、信息等分享到其他设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導出服務商配置（包含 API 密鑰）。通過 AirDrop、信息等分享到其他設備。"
          }
        }
      }
    },
