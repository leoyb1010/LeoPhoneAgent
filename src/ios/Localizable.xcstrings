            "value": "Gib den Abonnementschlüssel für Azure Speech Services ein. Setze die Basis-URL auf deine Region, z. B. https://eastasia.tts.speech.microsoft.com"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the Azure Speech Services subscription key. Set the base URL to your region, e.g. https://eastasia.tts.speech.microsoft.com"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis la clé d’abonnement Azure Speech Services. Définis l’URL de base sur ta région, par ex. https://eastasia.tts.speech.microsoft.com"
