        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld image(s) plus ancienne(s) retirée(s) de la requête pour respecter le budget de 25 Mo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "25MB の上限に収めるため、古い %lld 枚の画像をリクエストから省略しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "25MB 한도에 맞추기 위해 오래된 이미지 %lld개를 요청에서 제외함"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые изображения (%lld) исключены из запроса для соблюдения лимита 25 МБ"
