    "Mount limit reached (%d). Remove an existing mount before adding a new one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mount-Limit erreicht (%d). Entfernen Sie einen vorhandenen Mount, bevor Sie einen neuen hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mount limit reached (%d). Remove an existing mount before adding a new one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de montages atteinte (%d). Supprimez un montage existant avant d'en ajouter un nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウント数の上限（%d）に達しました。新規追加の前に既存のマウントを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마운트 한도(%d)에 도달했습니다. 새로 추가하기 전에 기존 마운트를 제거하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут лимит подключений (%d). Удалите существующее подключение, прежде чем добавлять новое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到挂载数量上限（%d）。请先移除一个已有挂载再添加新的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已達到掛載數量上限（%d）。請先移除一個已有掛載再添加新的。"
          }
        }
      }
    },
    "Mount limit reached. Remove an existing mount before adding a new one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mount-Limit erreicht. Entfernen Sie einen vorhandenen Mount, bevor Sie einen neuen hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mount limit reached. Remove an existing mount before adding a new one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de montages atteinte. Supprimez un montage existant avant d'en ajouter un nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウント数の上限に達しました。新規追加の前に既存のマウントを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마운트 한도에 도달했습니다. 새로 추가하기 전에 기존 마운트를 제거하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут лимит подключений. Удалите существующее подключение, прежде чем добавлять новое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到挂载数量上限。请先移除一个已有挂载再添加新的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已達到掛載數量上限。請先移除一個已有掛載再添加新的。"
          }
        }
      }
    },
