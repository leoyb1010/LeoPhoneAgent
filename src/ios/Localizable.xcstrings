    "Runs a LeoPhoneAgent quick task from your editable task library.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt eine LeoPhoneAgent-Schnellaufgabe aus Ihrer bearbeitbaren Aufgabenbibliothek aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute une tâche rapide LeoPhoneAgent à partir de votre bibliothèque de tâches modifiables."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集可能なタスク ライブラリから LeoPhoneAgent クイック タスクを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 가능한 작업 라이브러리에서 LeoPhoneAgent 빠른 작업을 실행합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает быструю задачу LeoPhoneAgent из вашей редактируемой библиотеки задач."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从可编辑任务库运行 LeoPhoneAgent 快速任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從可編輯任務庫執行 LeoPhoneAgent 快速任務。"
          }
        }
      }
    },
    "Runs a predefined LeoPhoneAgent task like sleep analysis, weather check, or morning briefing.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt eine vordefinierte LeoPhoneAgent-Aufgabe wie Schlafanalyse, Wettercheck oder Morgenbriefing aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs a predefined LeoPhoneAgent task like sleep analysis, weather check, or morning briefing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute une tâche LeoPhoneAgent prédéfinie comme l'analyse du sommeil, la météo ou le briefing matinal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠分析、天気確認、朝のブリーフィングなど、事前定義された LeoPhoneAgent タスクを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
