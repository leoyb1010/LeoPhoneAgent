    "Above the provider's reported limit of %lld — the API may reject requests.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über dem vom Anbieter gemeldeten Limit von %lld — die API kann Anfragen ablehnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above the provider's reported limit of %lld — the API may reject requests."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-dessus de la limite signalée par le fournisseur de %lld — l'API peut rejeter les requêtes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーが報告した上限 %lld を超えています — API がリクエストを拒否する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공급자가 보고한 %lld 한도를 초과했습니다 — API가 요청을 거부할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выше заявленного провайдером лимита в %lld — API может отклонять запросы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高于服务商上报的 %lld 上限 — API 可能会拒绝请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高於服務商上報的 %lld 上限 — API 可能會拒絕請求。"
