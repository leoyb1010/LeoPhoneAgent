    "Camera": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机"
          }
        }
      }
    },
    "Capture images for a conversation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为对话拍摄图片"
          }
        }
      }
    },
    "Captured media stays in the current conversation and is sent only to its selected AI provider when used.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍下的内容留在当前对话里,只有用到时才发给这次对话选的 AI 服务商。"
          }
        }
      }
    },
    "ChatGPT sign-in failed (%@). Please try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT 登录失败（%@），请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT 登入失敗（%@），請重試。"
          }
        }
      }
    },
    "Chats and Files": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话与文件"
          }
        }
      }
    },
    "Check the result before trying the action again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先确认结果,再决定要不要重做"
          }
        }
      }
    },
    "Check the selected provider credentials": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查所选 AI 服务商的登录或密钥"
          }
        }
      }
    },
    "Check the selected provider, credentials and model before retrying.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试前先检查所选 AI 服务商、登录 / 密钥和模型。"
          }
        }
      }
    },
    "Checked on Use": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用时检查"
          }
        }
      }
    },
    "Choose which data this device pushes to iCloud. Environment variables and provider API keys are stored in your private iCloud encoded, not encrypted. Turn those two categories off to keep secrets on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which data this device pushes to iCloud. Environment variables and provider API keys are stored in your private iCloud encoded, not encrypted. Turn those two categories off to keep secrets on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择本设备推送到 iCloud 的数据类型。环境变量和服务商 API 密钥会以编码（非加密）形式存进你的私人 iCloud；不想让密钥上云，请关掉这两类。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇本裝置推送到 iCloud 的資料類型。環境變數和服務商 API 金鑰會以編碼（非加密）形式存進你的私人 iCloud；不想讓金鑰上雲，請關掉這兩類。"
          }
        }
      }
    },
    "Classify visual content": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别画面内容"
          }
        }
      }
    },
    "Claude subscription sign-in has been retired. Use an API key instead, or the official claude CLI on your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 订阅登录已下线，请改用 API Key 或在 Mac 上用官方 claude CLI"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 訂閱登入已下線，請改用 API Key 或在 Mac 上用官方 claude CLI"
          }
        }
      }
    },
    "Clear all config changes?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear all config changes?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
