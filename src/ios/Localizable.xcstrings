    "Add a provider to get started.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie einen KI-Anbieter hinzu, um zu beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a provider to get started."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un fournisseur AI pour commencer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始するにはAIプロバイダーを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하려면 AI 공급자를 추가하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте провайдера, чтобы начать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个 AI 服务商以开始使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一個 AI 服務商以開始使用。"
          }
        }
      }
    },
    "Add an MCP server to give the agent extra tools. Tap + to add one manually or import a JSON config.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen MCP-Server hinzu, um dem Agenten zusätzliche Werkzeuge zu geben. Tippe auf +, um manuell einen hinzuzufügen, oder importiere eine JSON-Konfiguration."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an MCP server to give the agent extra tools. Tap + to add one manually or import a JSON config."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un serveur MCP pour donner des outils supplémentaires à l'agent. Touchez + pour en ajouter un manuellement ou importez une configuration JSON."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP サーバを追加して、エージェントに追加のツールを提供します。+ をタップして手動で追加するか、JSON 設定をインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP 서버를 추가하여 에이전트에 추가 도구를 제공합니다. +를 눌러 직접 추가하거나 JSON 구성을 가져오세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте сервер MCP, чтобы дать агенту дополнительные инструменты. Нажмите +, чтобы добавить вручную, или импортируйте конфигурацию JSON."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 MCP 服务器，为智能体提供额外工具。点按 + 手动添加，或导入 JSON 配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 MCP 服務器，為智能體提供額外工具。點按 + 手動添加，或導入 JSON 配置。"
          }
        }
      }
    },
