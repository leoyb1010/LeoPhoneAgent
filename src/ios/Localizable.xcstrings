    "Turn off to hide this voice service. The provider's text models are unaffected.": {
      "comment": "Shadow voice toggle note",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivieren, um diesen Sprachdienst auszublenden. Die Textmodelle des Anbieters sind nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off to hide this voice service. The provider's text models are unaffected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive pour masquer ce service vocal. Les modèles de texte du fournisseur ne sont pas affectés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにするとこの音声サービスを非表示にします。プロバイダーのテキストモデルには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 음성 서비스를 숨기려면 끄세요. 제공자의 텍스트 모델에는 영향이 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите, чтобы скрыть этот голосовой сервис. Текстовые модели провайдера не затрагиваются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭以隐藏此语音服务。服务商的文本模型不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉以隱藏此語音服務。服務商的文字模型不受影響。"
          }
        }
      }
    },
