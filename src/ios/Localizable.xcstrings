    "Tap + to pick a folder from Files (e.g. an Obsidian vault in iCloud Drive).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf +, um einen Ordner aus „Dateien“ auszuwählen (z. B. einen Obsidian-Tresor in iCloud Drive)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + to pick a folder from Files (e.g. an Obsidian vault in iCloud Drive)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez + pour choisir un dossier dans Fichiers (ex. un coffre Obsidian dans iCloud Drive)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+ をタップして「ファイル」からフォルダを選択します（例：iCloud Drive 内の Obsidian ボールト）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+를 탭하여 파일 앱에서 폴더를 선택하세요 (예: iCloud Drive의 Obsidian 볼트)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите +, чтобы выбрать папку из «Файлов» (например, хранилище Obsidian в iCloud Drive)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 + 从“文件”中选择文件夹（如 iCloud Drive 中的 Obsidian 仓库）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按 + 從“文件”中選擇文件夾（如 iCloud Drive 中的 Obsidian 倉庫）。"
          }
        }
      }
    },
    "Tap an artifact for Quick Look. Swipe to share or move it to Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf ein Artefakt, um einen Schnellüberblick zu erhalten. Wischen Sie, um es zu teilen oder in den Papierkorb zu verschieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur un artefact pour un aperçu rapide. Faites glisser pour le partager ou le déplacer vers la corbeille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイックルックのアーティファクトをタップします。スワイプして共有するか、ゴミ箱に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "훑어보기를 위한 아티팩트를 탭하세요. 스와이프하여 공유하거나 휴지통으로 이동하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь артефакта для быстрого просмотра. Проведите пальцем, чтобы поделиться или переместить в корзину."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点产出文件即可快速查看；轻扫可分享或移到最近删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊工件進行快速檢視。滑動即可分享或將其移至垃圾箱。"
          }
        }
      }
    },
