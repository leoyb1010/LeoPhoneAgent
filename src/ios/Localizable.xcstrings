    "V2 sync · per-device presence records so each device knows the others online.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "V2-Synchronisierung · Präsenzdatensätze pro Gerät, damit jedes Gerät weiß, welche anderen online sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "V2 sync · per-device presence records so each device knows the others online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation V2 · enregistrements de présence par appareil pour que chaque appareil connaisse les autres en ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "V2 同期 · 各デバイスが他のデバイスのオンライン状態を把握するためのデバイスごとのプレゼンスレコード。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "V2 동기화 · 각 기기가 다른 기기의 온라인 상태를 알 수 있도록 하는 기기별 프레즌스 레코드."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация V2 · записи присутствия по устройствам, чтобы каждое устройство знало, какие другие онлайн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "V2 同步 · 每台设备的在线状态记录，让每台设备知道其他设备是否在线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "V2 同步 · 每台裝置的在線狀態記錄，讓每台裝置知道其他裝置是否在線。"
          }
        }
      }
    },
