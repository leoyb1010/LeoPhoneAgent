    "Choose a specific voice for each language. Download more voices in Settings > Accessibility > Spoken Content > Voices.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Stimme für jede Sprache. Laden Sie weitere Stimmen unter Einstellungen > Bedienungshilfen > Gesprochene Inhalte > Stimmen herunter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a specific voice for each language. Download more voices in Settings > Accessibility > Spoken Content > Voices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une voix pour chaque langue. Téléchargez d'autres voix dans Réglages > Accessibilité > Contenu énoncé > Voix."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各言語の音声を選択できます。設定 > アクセシビリティ > 読み上げコンテンツ > 声 でより多くの音声をダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 언어의 음성을 선택하세요. 설정 > 손쉬운 사용 > 음성 콘텐츠 > 음성에서 더 많은 음성을 다운로드할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите конкретный голос для каждого языка. Загрузить дополнительные голоса можно в «Настройки» > «Универсальный доступ» > «Устный контент» > «Голоса»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每种语言选择特定语音。在「设置 > 辅助功能 > 朗读内容 > 语音」中下载更多语音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "爲每種語言選擇特定語音。在「設置 > 輔助功能 > 朗讀內容 > 語音」中下載更多語音。"
          }
        }
      }
    },
