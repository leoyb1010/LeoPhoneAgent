          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить ваши настройки и восстановить значения, сообщённые провайдером."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
