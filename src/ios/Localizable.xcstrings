          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Ceci est la zone propre à CET appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ これは「このデバイス」自身のゾーンです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
