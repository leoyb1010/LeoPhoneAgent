    },
    "Hidden models disappear from model selection and chat-group fallback. Saved direct-chat and voice bindings remain. Favorites and group membership are preserved; show the models again to restore availability.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden models disappear from model selection and chat-group fallback. Saved direct-chat and voice bindings remain. Favorites and group membership are preserved; show the models again to restore availability."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏后，模型不再出现在选择器和对话分组回退中。已有的直接对话和语音绑定会保留。收藏和分组成员关系也会保留，重新显示即可恢复可选状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏後，模型不再出現在選擇器和對話分組備援中。已有的直接對話和語音綁定會保留。收藏和分組成員關係也會保留，重新顯示即可恢復可選狀態。"
          }
        }
      }
    },
    "Primary starts new chats. Sub handles lightweight tasks such as titles. Choosing a model in an existing chat does not change these defaults.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Primary starts new chats. Sub handles lightweight tasks such as titles. Choosing a model in an existing chat does not change these defaults."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主模型用于新对话，轻量模型用于生成标题等任务。在已有对话中切换模型不会更改这些默认设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主模型用於新對話，輕量模型用於產生標題等任務。在已有對話中切換模型不會更改這些預設設定。"
          }
        }
      }
    },
