    "Re-runs the AI agent from a specific user message in a session. Presents a list of user messages to choose from, then retries from that point.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt den KI-Agenten ab einer bestimmten Benutzernachricht in einer Sitzung erneut aus. Zeigt eine Liste von Benutzernachrichten zur Auswahl und wiederholt ab diesem Punkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-runs the AI agent from a specific user message in a session. Presents a list of user messages to choose from, then retries from that point."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relance l'agent IA à partir d'un message utilisateur spécifique dans une session. Présente une liste de messages utilisateur à choisir, puis retente à partir de ce point."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッション内の特定のユーザーメッセージからAIエージェントを再実行します。ユーザーメッセージのリストから選択し、その時点から再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션의 특정 사용자 메시지에서 AI 에이전트를 다시 실행합니다. 선택할 사용자 메시지 목록을 표시한 다음 해당 시점부터 다시 시도합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапускает AI-агента с определённого сообщения пользователя в сессии. Показывает список сообщений пользователя на выбор, а затем повторяет с этого момента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
