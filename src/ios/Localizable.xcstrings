            "value": "どのようなフォローアップを送信しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 후속 질문을 보내시겠어요?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какое уточнение вы хотите отправить?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您想发送什么后续问题？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您想發送什麼後續問題？"
          }
        }
      }
    },
    "What it can access": {
      "localizations": {
