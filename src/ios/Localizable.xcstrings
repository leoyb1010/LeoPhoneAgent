    "Your key is stored in the iOS Keychain and used only to authenticate requests sent directly to this provider. Provider configuration can sync through your private iCloud account when iCloud Sync is enabled.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Schlüssel wird im iOS Keychain gespeichert und nur zur Authentifizierung von Anfragen verwendet, die direkt an diesen Anbieter gesendet werden. Die Anbieterkonfiguration kann über Ihr privates iCloud-Konto synchronisiert werden, wenn die iCloud-Synchronisierung aktiviert ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé est stockée dans le iOS Keychain et utilisée uniquement pour authentifier les demandes envoyées directement à ce fournisseur. La configuration du fournisseur peut être synchronisée via votre compte privé iCloud lorsque iCloud Sync est activé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーは iOS Keychain に保存され、このプロバイダーに直接送信されるリクエストを認証するためにのみ使用されます。 iCloud 同期が有効になっている場合、プロバイダー構成はプライベート iCloud アカウントを通じて同期できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 키는 iOS Keychain에 저장되며 이 공급자에게 직접 전송된 요청을 인증하는 데에만 사용됩니다. iCloud 동기화가 활성화되면 공급자 구성은 개인 iCloud 계정을 통해 동기화할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ хранится в iOS Keychain и используется только для аутентификации запросов, отправленных непосредственно этому провайдеру. Конфигурацию поставщика можно синхронизировать через вашу личную учетную запись iCloud, если включена синхронизация iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的密钥存储在 iOS Keychain 中，仅用于验证直接发送到此提供商的请求。当启用 iCloud 同步时，提供商配置可以通过您的私人 iCloud 帐户同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的金鑰儲存在 iOS Keychain 中，僅用於驗證直接傳送至此提供者的請求。當啟用 iCloud 同步時，提供者配置可以透過您的私人 iCloud 帳戶同步。"
          }
        }
      }
    },
    "Your key is stored securely in the iOS Keychain and never leaves the device.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Schlüssel wird sicher im iOS-Schlüsselbund gespeichert und verlässt das Gerät nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your key is stored securely in the iOS Keychain and never leaves the device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé est stockée en toute sécurité dans le trousseau iOS et ne quitte jamais l'appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはiOS キーチェーンに安全に保存され、デバイスから送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 iOS 키체인에 안전하게 저장되며 기기를 벗어나지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ надёжно хранится в Связке ключей iOS и никогда не покидает устройство."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的密钥安全存储在 iOS 钥匙串中，不会离开设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
