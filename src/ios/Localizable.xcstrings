          "stringUnit": {
            "state": "translated",
            "value": "接近上限时会自动压缩历史（保留摘要），这会让缓存失效并可能丢失早期细节。想保留完整细节可以开新会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
