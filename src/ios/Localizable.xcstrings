    "Configure providers in Settings to see models here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie Anbieter in den Einstellungen, um Modelle hier zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure providers in Settings to see models here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez les fournisseurs dans Réglages pour voir les modèles ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でプロバイダーを構成すると、ここにモデルが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
