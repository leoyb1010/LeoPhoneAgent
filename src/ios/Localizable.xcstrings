    "Uses /v1/responses endpoint format.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet das Endpoint-Format /v1/responses."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses /v1/responses endpoint format."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le format de point de terminaison /v1/responses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/v1/responses エンドポイントの形式を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "/v1/responses 엔드포인트 형식을 사용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует формат эндпоинта /v1/responses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 /v1/responses 端点格式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 /v1/responses 端點格式。"
          }
        }
      }
    },
    "Uses /v1/responses endpoint format. Required for some Responses-API-only services.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet das Endpoint-Format /v1/responses. Für einige Dienste, die nur die Responses-API unterstützen, erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses /v1/responses endpoint format. Required for some Responses-API-only services."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le format de point de terminaison /v1/responses. Requis pour certains services qui n'acceptent que l'API Responses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/v1/responses エンドポイントの形式を使用します。Responses API のみをサポートする一部のサービスで必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "/v1/responses 엔드포인트 형식을 사용합니다. Responses API만 지원하는 일부 서비스에 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует формат эндпоинта /v1/responses. Требуется для некоторых сервисов, работающих только с Responses API."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 /v1/responses 端点格式。某些仅支持 Responses API 的服务必须使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 /v1/responses 端點格式。某些僅支援 Responses API 的服務必須使用。"
          }
        }
      }
    },
    "Uses low-accuracy location updates to prevent iOS from suspending the app while agent tasks are running in the background.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet ungenaue Standortaktualisierungen, um zu verhindern, dass iOS die App während der Hintergrundausführung pausiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses low-accuracy location updates to prevent iOS from suspending the app while agent tasks are running in the background."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise des mises à jour de localisation basse précision pour empêcher iOS de suspendre l'app pendant les tâches en arrière-plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低精度の位置情報更新を使用して、エージェントタスクのバックグラウンド実行中にiOSがアプリを一時停止するのを防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 작업이 백그라운드에서 실행되는 동안 iOS가 앱을 일시 중지하지 않도록 저정밀 위치 업데이트를 사용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует обновления геопозиции с низкой точностью, чтобы iOS не приостанавливала приложение, пока задачи Agent выполняются в фоне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用低精度定位更新，防止 iOS 在后台运行智能体任务时挂起应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用低精度定位更新，防止 iOS 在後臺運行智能體任務時掛起應用。"
          }
        }
      }
    },
    "Using custom viewport %lld×%lld. Tap Default to revert to the UA default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzerdefiniertes Viewport %lld×%lld wird verwendet. Tippen Sie auf „Standard“, um zur UA-Standardeinstellung zurückzukehren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Using custom viewport %1$lld×%2$lld. Tap Default to revert to the UA default."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewport personnalisé %lld×%lld utilisé. Appuyez sur « Par défaut » pour revenir à la valeur par défaut de l'UA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムビューポート %lld×%lld を使用しています。UA デフォルトに戻すには「デフォルト」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 뷰포트 %lld×%lld를 사용 중입니다. UA 기본값으로 되돌리려면 “기본값”을 탭하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется произвольная область просмотра %1$lld×%2$lld. Нажмите «По умолчанию», чтобы вернуться к значению UA."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自定义视口 %lld×%lld。点按“默认”可恢复为 UA 默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自訂視窗 %lld×%lld。點按「預設」可恢復為 UA 預設值。"
          }
        }
      }
    },
    "Using UA default %lld×%lld. Set a custom size to override.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UA-Standard %lld×%lld wird verwendet. Legen Sie eine benutzerdefinierte Größe fest, um diese zu überschreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Using UA default %1$lld×%2$lld. Set a custom size to override."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeur par défaut de l'UA %lld×%lld utilisée. Définissez une taille personnalisée pour la remplacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UA デフォルトの %lld×%lld を使用しています。上書きするにはカスタムサイズを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UA 기본값 %lld×%lld를 사용 중입니다. 재정의하려면 사용자 지정 크기를 설정하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется значение UA по умолчанию %1$lld×%2$lld. Задайте произвольный размер, чтобы переопределить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 UA 默认 %lld×%lld。设置自定义大小可覆盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 UA 預設 %lld×%lld。設置自訂大小可覆蓋。"
          }
        }
      }
    },
