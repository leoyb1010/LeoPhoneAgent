          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此分組用於語音輸出 — 僅列出能夠輸出音訊的模型。"
          }
        }
      }
    },
    "This JSON file looks like an exported provider configuration. Import it as a new provider, or add it to the chat as a file attachment?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese JSON-Datei sieht wie eine exportierte Anbieter-Konfiguration aus. Als neuen Anbieter importieren oder als Dateianhang zum Chat hinzufügen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This JSON file looks like an exported provider configuration. Import it as a new provider, or add it to the chat as a file attachment?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier JSON ressemble à une configuration de fournisseur exportée. L'importer comme nouveau fournisseur ou l'ajouter comme pièce jointe ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このJSONファイルはエクスポートされたプロバイダ設定のようです。新しいプロバイダとしてインポートしますか、それともチャットの添付ファイルとして追加しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 JSON 파일은 내보낸 공급자 구성으로 보입니다. 새 공급자로 가져오시겠습니까, 아니면 채팅 첨부 파일로 추가하시겠습니까?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот JSON-файл похож на экспортированную конфигурацию провайдера. Импортировать как нового провайдера или добавить как вложение в чат?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 JSON 文件看起来是导出的供应商配置。是否导入为新供应商，还是作为文件附件添加到聊天？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 JSON 檔案看起來是匯出的供應商設定。是否匯入為新供應商，還是作為檔案附件新增到聊天？"
          }
        }
      }
    },
    "This location is inside a read-only mounted folder and cannot be modified: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ort befindet sich in einem schreibgeschützten, eingehängten Ordner und kann nicht geändert werden: %@"
          }
        },
        "en": {
