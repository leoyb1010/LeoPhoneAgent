    "About %lld local records will upload to iCloud. Estimated time ~%lld hr depending on iCloud throttling. You can pause or cancel any time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "About %1$lld local records will upload to iCloud. Estimated time ~%2$lld hr depending on iCloud throttling. You can pause or cancel any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 %1$lld 条本地记录将上传至 iCloud。预计耗时 ~%2$lld 小时（受 iCloud 限流影响）。可随时暂停或取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於%lld本機記錄將上傳至iCloud。預計時間 ~%lld 小時，取決於 iCloud 節流。您可以隨時暫停或取消。"
          }
        }
      }
    },
