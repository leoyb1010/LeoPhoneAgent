    "V2 sync · chat sessions, messages, compact markers, attachments, skills. Shared by all your devices.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "V2-Synchronisierung · Chat-Sitzungen, Nachrichten, Komprimierungsmarker, Anhänge, Skills. Von allen deinen Geräten gemeinsam genutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "V2 sync · chat sessions, messages, compact markers, attachments, skills. Shared by all your devices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation V2 · sessions de conversation, messages, marqueurs de compactage, pièces jointes, compétences. Partagé par tous tes appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "V2 同期 · チャットセッション、メッセージ、圧縮マーカー、添付ファイル、スキル。すべてのデバイスで共有されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "V2 동기화 · 채팅 세션, 메시지, 압축 마커, 첨부 파일, 스킬. 모든 기기에서 공유됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация V2 · сессии чата, сообщения, маркеры сжатия, вложения, навыки. Общие для всех ваших устройств."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "V2 同步 · 聊天会话、消息、压缩标记、附件、技能。由你的所有设备共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "V2 同步 · 聊天工作階段、訊息、壓縮標記、附件、技能。由你的所有裝置共享。"
          }
        }
      }
    },
    "V2 sync · environment variables (API keys, etc.) used by your AI tools.": {
      "localizations": {
