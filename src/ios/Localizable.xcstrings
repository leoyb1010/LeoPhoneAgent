        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中の変更はローカルに保存され、一時停止が終了するとプッシュされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류 중인 변경 사항은 로컬로 보존되며 일시 중지가 끝나면 푸시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
