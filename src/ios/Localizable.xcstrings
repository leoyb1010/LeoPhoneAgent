    "Adjust session spacing without changing text size or accessibility settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie den Sitzungsabstand an, ohne die Textgröße oder die Barrierefreiheitseinstellungen zu ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez l’espacement des sessions sans modifier la taille du texte ou les paramètres d’accessibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキスト サイズやアクセシビリティ設定を変更せずに、セッションの間隔を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 크기나 접근성 설정을 변경하지 않고 세션 간격을 조정하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регулируйте интервал между сеансами, не меняя размер текста или настройки специальных возможностей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整会话间距而不更改文本大小或辅助功能设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整會話間距而不變更文字大小或輔助功能設定。"
          }
        }
      }
    },
