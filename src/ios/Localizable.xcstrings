        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending changes are preserved locally and pushed once the pause ends."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications en attente sont conservées localement et repoussées une fois la pause terminée."
          }
