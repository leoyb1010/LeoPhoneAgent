            "value": "Ältere %lld Bild(er) aus der Anfrage entfernt, um das 25-MB-Budget einzuhalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older %lld image(s) elided from request to fit 25MB budget"
