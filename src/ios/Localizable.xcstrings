            "value": "歡迎使用 LeoBot"
          }
        }
      }
    },
    "What follow-up would you like to send?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What follow-up would you like to send?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还想追问什么？"
          }
        },
        "zh-Hant": {
