    },
    "API keys and tokens are stored only in the iOS Keychain on your device and are never sent to us": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel und Token werden nur im iOS Keychain auf Ihrem Gerät gespeichert und niemals an uns gesendet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API keys and tokens are stored only in the iOS Keychain on your device and are never sent to us"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés API et Token sont stockées uniquement dans le iOS Keychain de votre appareil et ne nous sont jamais envoyées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーと Token は、デバイス上の iOS Keychain にのみ保存され、当社に送信されることはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키 및 Token은 장치의 iOS Keychain에만 저장되며 당사로 전송되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "APIключи иTokenхранятся только вiOS Keychainна вашем устройстве и никогда не отправляются нам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥和 Token 仅存储在您设备上的 iOS Keychain 中，并且绝不会发送给我们"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密鑰和 Token 僅儲存在您裝置上的 iOS Keychain 中，且絕不會傳送給我們"
          }
        }
      }
    },
