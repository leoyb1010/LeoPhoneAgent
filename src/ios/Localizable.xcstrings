    "This mount is exposed as read-only to protect it from accidental edits.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mount ist schreibgeschützt, um versehentliche Änderungen zu verhindern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This mount is exposed as read-only to protect it from accidental edits."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce point de montage est en lecture seule pour éviter les modifications accidentelles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誤編集を防ぐため、このマウントは読み取り専用として公開されています。"
