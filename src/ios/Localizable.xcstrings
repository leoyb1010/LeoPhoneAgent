    "Devices that are signed in to the same iCloud account and have sync enabled. Last seen reflects the most recent push from that device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte, die bei demselben iCloud-Konto angemeldet sind und bei denen die Synchronisierung aktiviert ist. „Zuletzt gesehen“ spiegelt den letzten Push von diesem Gerät wider."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices that are signed in to the same iCloud account and have sync enabled. Last seen reflects the most recent push from that device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareils connectés au même compte iCloud et sur lesquels la synchronisation est activée. La dernière vue reflète la poussée la plus récente de cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ iCloud アカウントにサインインし、同期が有効になっているデバイス。最後に表示された内容は、そのデバイスからの最新のプッシュを反映します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일한 iCloud 계정에 로그인되어 있고 동기화가 활성화된 장치입니다. 마지막 확인은 해당 장치의 가장 최근 푸시를 반영합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства, на которых выполнен вход в одну и ту же учетную запись iCloud и на которых включена синхронизация. Последнее посещение отражает самый последний запрос с этого устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录到同一 iCloud 账号且启用了同步的设备。最近活跃反映该设备最近一次推送的时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入相同 iCloud 帳戶並啟用同步的裝置。最後看到的內容反映了該設備的最新推播。"
          }
        }
      }
    },
