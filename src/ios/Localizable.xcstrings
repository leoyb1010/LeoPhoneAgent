    "Choose what to show when the app starts. \"Auto\" opens a new chat if the last session is older than 15 minutes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what to show when the app starts. \"Auto\" opens a new chat if the last session is older than 15 minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择应用启动时显示的内容。\"自动\"会在上次会话超过 15 分钟时打开新对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇應用啓動時顯示的內容。\"自動\"會在上次會話超過 15 分鐘時打開新對話。"
          }
        }
      }
    },
    "Choose whether the Return key in the chat input inserts a newline or sends the message. Hardware Shift+Return always inserts a newline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether the Return key in the chat input inserts a newline or sends the message. Hardware Shift+Return always inserts a newline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择聊天输入框中回车键的行为：插入换行或发送消息。硬件键盘 Shift+Return 始终插入换行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇聊天輸入框中回車鍵的行爲：插入換行或發送消息。硬件鍵盤 Shift+Return 始終插入換行。"
          }
        }
      }
    },
    "Choose which data this device pushes to iCloud. API keys and secrets are synced securely via iCloud Keychain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which data this device pushes to iCloud. API keys and secrets are synced securely via iCloud Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择本设备推送到 iCloud 的数据类型。API 密钥和敏感信息通过 iCloud 钥匙串安全同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇本裝置推送到 iCloud 的資料類型。API 金鑰和機密資訊透過 iCloud 鑰匙圈安全同步。"
          }
        }
      }
    },
