    "iFlytek needs App ID and API Secret — enter them as \"appId;apiKey;apiSecret\" in the API Key field.": {
      "comment": "Voice provider credential note",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iFlytek benötigt App-ID und API-Secret – gib sie als „appId;apiKey;apiSecret“ im Feld API-Schlüssel ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iFlytek needs App ID and API Secret — enter them as \"appId;apiKey;apiSecret\" in the API Key field."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iFlytek nécessite l’App ID et l’API Secret — saisis-les sous la forme « appId;apiKey;apiSecret » dans le champ Clé API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iFlytek には App ID と API Secret が必要です — API キー欄に「appId;apiKey;apiSecret」の形式で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iFlytek에는 App ID와 API Secret이 필요합니다 — API 키 필드에 \"appId;apiKey;apiSecret\" 형식으로 입력하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iFlytek требует App ID и API Secret — введите их как «appId;apiKey;apiSecret» в поле ключа API."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "讯飞需要 App ID 和 API Secret — 请在 API Key 字段中以“appId;apiKey;apiSecret”的形式填写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊飛需要 App ID 和 API Secret — 請在 API Key 欄位中以「appId;apiKey;apiSecret」的形式填寫。"
          }
        }
      }
    },
