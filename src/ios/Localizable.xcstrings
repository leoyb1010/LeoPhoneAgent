    "✅ Rootfs reset. /root was backed up on this device — restart the app, then tap Restore User Data.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "✅ Rootfs 已重置。/root 已备份在这台设备上——重启 App 后，点「恢复用户数据」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "✅ Rootfs 已重置。/root 已備份在這台裝置上——重新啟動 App 後，點「恢復用戶數據」。"
          }
        }
      }
    },
    "✅ Rootfs reset. There was no /root to back up.": {
      "localizations": {
