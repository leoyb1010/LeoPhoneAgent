    "Images, videos, or files to attach to the prompt. Accepts output from previous Shortcuts actions (e.g. filtered photos or documents).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder, Videos oder Dateien zum Anhängen an den Prompt. Akzeptiert Ausgaben vorheriger Kurzbefehl-Aktionen (z. B. gefilterte Fotos oder Dokumente)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images, videos, or files to attach to the prompt. Accepts output from previous Shortcuts actions (e.g. filtered photos or documents)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images, vidéos ou fichiers à joindre au prompt. Accepte la sortie des actions Raccourcis précédentes (ex. photos filtrées ou documents)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプトに添付する画像、動画、またはファイル。前のショートカットアクションからの出力を受け付けます（例：フィルタリングされた写真やドキュメント）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프롬프트에 첨부할 이미지, 동영상 또는 파일. 이전 단축어 작업의 출력을 받습니다(예: 필터링된 사진 또는 문서)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображения, видео или файлы для прикрепления к запросу. Принимает результат предыдущих действий Shortcuts (например, отфильтрованные фото или документы)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附加到提示的图片、视频或文件。接受来自快捷指令的输出（如筛选后的照片或文档）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附加到提示的圖片、視頻或文件。接受來自快捷指令的輸出（如篩選後的照片或文檔）。"
          }
        }
      }
    },
