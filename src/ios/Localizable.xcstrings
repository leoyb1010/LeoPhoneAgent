    "Use a static bearer token instead of the OAuth sign-in flow. Useful with custom proxy endpoints.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie einen statischen Träger Token anstelle des Anmeldeflusses OAuth. Nützlich bei benutzerdefinierten Proxy-Endpunkten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a static bearer token instead of the OAuth sign-in flow. Useful with custom proxy endpoints."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un support statique Token au lieu du flux de connexion OAuth. Utile avec les points de terminaison proxy personnalisés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth サインイン フローの代わりに静的ベアラー Token を使用します。カスタム プロキシ エンドポイントで便利です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth 로그인 흐름 대신 정적 전달자 Token을 사용하세요. 사용자 정의 프록시 엔드포인트에 유용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте статический носительTokenвместоOAuthпроцесс входа в систему. Полезно с пользовательскими конечными точками прокси."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用静态承载 Token 而不是 OAuth 登录流程。对于自定义代理端点很有用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用靜態承載 Token 而不是 OAuth 登入流程。對於自訂代理端點很有用。"
          }
        }
      }
    },
