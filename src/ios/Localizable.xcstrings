    "Pending changes are preserved locally and pushed once the pause ends.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausstehende Änderungen werden lokal gespeichert und nach Ablauf der Pause gepusht."
          }
