          }
        }
      }
    },
    "Configure which models the agent uses, manage API keys & OAuth for each provider, and create model groups for fallback or load balancing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie die Modelle des Agenten, verwalten Sie API Keys und OAuth für jeden KI-Anbieter und erstellen Sie Modellgruppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure which models the agent uses, manage API keys & OAuth for each provider, and create model groups for fallback or load balancing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez les modèles utilisés par l'agent, gérez les clés API et OAuth de chaque fournisseur AI, et créez des groupes de modèles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが使用するモデルの設定、各AIプロバイダーのAPI KeyとOAuthの管理、フォールバックや負荷分散のためのモデルグループの作成ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 사용할 모델을 설정하고, 각 AI 공급자의 API Key와 OAuth를 관리하며, 대체 또는 부하 분산을 위한 모델 그룹을 만드세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте, какие модели использует Agent, управляйте ключами API и OAuth для каждого провайдера и создавайте группы моделей для резервирования или балансировки нагрузки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置智能体使用的模型，管理各 AI 服务商的 API Key 和 OAuth，以及创建模型分组以实现回退或负载均衡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配置智能體使用的模型，管理各 AI 服務商的 API Key 和 OAuth，以及創建模型分組以實現回退或負載均衡。"
          }
        }
      }
    },
