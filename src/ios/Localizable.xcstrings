    "Auto: tries /v1/images/generations first, falls back to /v1/chat/completions. Caches the working endpoint after the first call.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch: Versucht zuerst /v1/images/generations, weicht auf /v1/chat/completions aus. Speichert den funktionierenden Endpoint nach dem ersten Aufruf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto: tries /v1/images/generations first, falls back to /v1/chat/completions. Caches the working endpoint after the first call."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto : essaie d'abord /v1/images/generations, bascule vers /v1/chat/completions. Met en cache le point de terminaison fonctionnel après le premier appel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動: 最初に /v1/images/generations を試し、失敗した場合は /v1/chat/completions にフォールバックします。最初の呼び出し後、動作するエンドポイントをキャッシュします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동: /v1/images/generations을 먼저 시도하고 실패 시 /v1/chat/completions으로 대체합니다. 첫 호출 후 동작하는 엔드포인트를 캐시합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Авто: сначала пробует /v1/images/generations, затем переключается на /v1/chat/completions. Рабочая конечная точка кэшируется после первого вызова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动：先尝试 /v1/images/generations，失败时回退到 /v1/chat/completions。首次调用后缓存可用端点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動：先嘗試 /v1/images/generations，失敗時回退到 /v1/chat/completions。首次呼叫後快取可用的端點。"
          }
        }
      }
    },
    "Auto: tries /v1/images/generations first, falls back to /v1/chat/completions. Last successful endpoint: %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch: Versucht zuerst /v1/images/generations, weicht auf /v1/chat/completions aus. Letzter erfolgreicher Endpoint: %@."
