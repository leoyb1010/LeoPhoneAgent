    "Existing session to continue. Leave empty for a new session.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestehende Sitzung fortsetzen. Leer lassen für eine neue Sitzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing session to continue. Leave empty for a new session."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Session existante à continuer. Laissez vide pour une nouvelle session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行する既存のセッション。空にすると新規セッションが作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속할 기존 세션. 비워두면 새 세션이 생성됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Существующая сессия для продолжения. Оставьте пустым для новой сессии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续现有会话。留空则创建新会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續現有會話。留空則創建新會話。"
          }
        }
      }
    },
    "Existing session to continue. Leave empty to start a new session.": {
