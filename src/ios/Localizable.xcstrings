    "Context full. Start a new session to continue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontext voll. Starten Sie eine neue Sitzung, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context full. Start a new session to continue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexte plein. Démarrez une nouvelle session pour continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテキストが満杯です。続行するには新しいセッションを開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨텍스트가 가득 찼습니다. 계속하려면 새 세션을 시작하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контекст заполнен. Начните новую сессию, чтобы продолжить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文已满。请开始新会话以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文已滿。請開始新工作階段以繼續。"
          }
        }
      }
    },
    "Context is full and could not be compacted further. Start a new session or clear the chat to continue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontext ist voll und konnte nicht weiter komprimiert werden. Starte eine neue Sitzung oder leere den Chat, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context is full and could not be compacted further. Start a new session or clear the chat to continue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contexte est plein et n’a pas pu être davantage compacté. Démarre une nouvelle session ou vide la conversation pour continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテキストがいっぱいで、これ以上圧縮できませんでした。続行するには新しいセッションを開始するか、チャットをクリアしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨텍스트가 가득 차 더 이상 압축할 수 없습니다. 계속하려면 새 세션을 시작하거나 채팅을 지우세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контекст переполнен и не может быть сжат дальше. Начните новую сессию или очистите чат, чтобы продолжить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文已满且无法进一步压缩。请开始新会话或清空对话以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文已滿且無法進一步壓縮。請開始新工作階段或清空對話以繼續。"
          }
        }
      }
    },
