          }
        }
      }
    },
    "What it can access": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可以访问什么"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它可以訪問什麼"
          }
        }
      }
    },
    "What should LeoBot do?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LeoBot 应该做什么？"
