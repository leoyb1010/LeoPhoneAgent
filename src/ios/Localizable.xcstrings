    "Only dedicated speech-to-text models are listed — those whose only input is audio (e.g. Whisper). Multimodal chat models that can also hear audio are not shown.": {
      "comment": "Voice input filter explanation",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only dedicated speech-to-text models are listed — those whose only input is audio (e.g. Whisper). Multimodal chat models that can also hear audio are not shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅列出专用的语音转文字模型 — 即唯一输入为音频的模型（如 Whisper）。同样能听音频的多模态聊天模型不会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅列出專用的語音轉文字模型 — 即唯一輸入為音訊的模型（如 Whisper）。同樣能聽音訊的多模態聊天模型不會顯示。"
          }
        }
      }
    },
    "Only dedicated text-to-speech models are listed — those whose only output is audio (e.g. TTS voices). Multimodal chat models are not shown.": {
      "comment": "Voice output filter explanation",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only dedicated text-to-speech models are listed — those whose only output is audio (e.g. TTS voices). Multimodal chat models are not shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅列出专用的文字转语音模型 — 即唯一输出为音频的模型（如 TTS 音色）。多模态聊天模型不会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅列出專用的文字轉語音模型 — 即唯一輸出為音訊的模型（如 TTS 音色）。多模態聊天模型不會顯示。"
          }
        }
      }
    },
    "Only files inside a session, the shared folder, or a mounted folder can be added to the Home Screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only files inside a session, the shared folder, or a mounted folder can be added to the Home Screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有会话内、共享文件夹或挂载文件夹中的文件才能添加到主屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有工作階段內、共用資料夾或掛載資料夾中的檔案才能加入主畫面。"
          }
        }
      }
    },
    "Only switch to the next model on provider-level errors such as rate limiting, invalid API key, or provider rejection. Network and server errors are retried on the current model first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only switch to the next model on provider-level errors such as rate limiting, invalid API key, or provider rejection. Network and server errors are retried on the current model first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在服务商级别的错误（如限流、API Key 无效或服务商拒绝）时切换到下一个模型。网络和服务器错误会先在当前模型上重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在服務商級別的錯誤（如限流、API Key 無效或服務商拒絕）時切換到下一個模型。網路和伺服器錯誤會先在當前模型上重試。"
          }
        }
      }
    },
