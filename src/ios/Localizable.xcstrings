    "Add variables like API keys or tokens that will be available in the shell environment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Variablen wie API-Schlüssel oder Token hinzu, die in der Shell-Umgebung verfügbar sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add variables like API keys or tokens that will be available in the shell environment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des variables telles que les clés API ou Token qui seront disponibles dans l'environnement shell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェル環境で使用できる API キーや Token などの変数を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셸 환경에서 사용할 수 있는 API 키 또는 Token과 같은 변수를 추가합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте переменные, такие как ключи API или Token, которые будут доступны в среде оболочки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
