    "Sessions are distributed across models for load balancing.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzungen werden zur Lastverteilung auf die Modelle verteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions are distributed across models for load balancing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions sont réparties entre les modèles pour la répartition de charge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションはロードバランシングのためモデル間で分散されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 부하 분산을 위해 모델 간에 분배됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессии распределяются между моделями для балансировки нагрузки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话在模型之间分配以实现负载均衡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會話在模型之間分配以實現負載均衡。"
          }
        }
      }
    },
    "Sessions are distributed across models. Each session sticks to its assigned model unless it fails.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzungen werden auf Modelle verteilt. Jede Sitzung bleibt bei ihrem zugewiesenen Modell, es sei denn, es schlägt fehl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions are distributed across models. Each session sticks to its assigned model unless it fails."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions sont réparties entre les modèles. Chaque session reste sur son modèle assigné sauf en cas d'échec."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションはモデル間で分配されます。各セッションは、失敗しない限り割り当てられたモデルに固定されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 모델 간에 분배됩니다. 각 세션은 실패하지 않는 한 할당된 모델을 유지합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессии распределяются между моделями. Каждая сессия остаётся на назначенной модели, пока она не даст сбой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话分布在各模型之间。每个会话固定使用其分配的模型，除非失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會話分佈在各模型之間。每個會話固定使用其分配的模型，除非失敗。"
          }
        }
      }
    },
