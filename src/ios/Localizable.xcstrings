      }
    },
    "This removes the local execution history. Conversations are not affected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der lokale Ausführungsverlauf entfernt. Gespräche sind nicht betroffen."
