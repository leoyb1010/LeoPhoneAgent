    "Close Activity and use Resume in the conversation to continue from the saved interruption point.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie die Aktivität und verwenden Sie „Fortsetzen“ im Gespräch, um ab dem gespeicherten Unterbrechungspunkt fortzufahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez l'activité et utilisez Reprendre dans la conversation pour continuer à partir du point d'interruption enregistré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティビティを閉じ、会話で [再開] を使用して、保存した中断ポイントから続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동을 닫고 대화에서 재개를 사용하여 저장된 중단 지점에서 계속하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закройте действие и используйте «Возобновить» в разговоре, чтобы продолжить с сохраненной точки прерывания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭“活动”并在对话中使用“恢复”以从保存的中断点继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉“活動”並在對話中使用“恢復”以從已儲存的中斷點繼續。"
          }
        }
      }
    },
