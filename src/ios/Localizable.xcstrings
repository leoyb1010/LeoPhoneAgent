          }
        }
      }
    },
    "When disabled, the agent cannot read or modify any settings via minis-config. The change history at Logs → Config Changes remains accessible. The agent will receive a permission_denied error and can guide you via deep links instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deaktiviert, kann der Agent keine Einstellungen über minis-config lesen oder ändern. Der Änderungsverlauf unter Logs → Konfigurationsänderungen bleibt zugänglich. Der Agent erhält einen permission_denied-Fehler und kann Sie stattdessen über Deep Links anleiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When disabled, the agent cannot read or modify any settings via minis-config. The change history at Logs → Config Changes remains accessible. The agent will receive a permission_denied error and can guide you via deep links instead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque désactivé, l'agent ne peut ni lire ni modifier les paramètres via minis-config. L'historique des modifications dans Journaux → Modifications de configuration reste accessible. L'agent recevra une erreur permission_denied et pourra vous guider via des liens profonds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効にすると、エージェントは minis-config 経由で設定を読み書きできません。ログ → 設定変更 の履歴は引き続き閲覧できます。エージェントには permission_denied エラーが返され、代わりにディープリンクで案内できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비활성화하면 에이전트가 minis-config 를 통해 설정을 읽거나 변경할 수 없습니다. 로그 → 설정 변경 의 이력은 계속 확인할 수 있습니다. 에이전트는 permission_denied 오류를 받고, 대신 딥 링크로 안내할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда выключено, Agent не может читать или изменять какие-либо настройки через minis-config. История изменений в разделе Логи → Изменения конфигурации остаётся доступной. Agent получит ошибку permission_denied и вместо этого сможет направить вас с помощью глубоких ссылок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用后，代理无法通过 minis-config 读取或修改任何设置。日志 → 设置更改 中的更改历史仍可访问。代理将收到 permission_denied 错误，并可以改为通过深层链接为你引导。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停用後，代理無法透過 minis-config 讀取或修改任何設定。記錄 → 設定變更 中的變更歷史仍可存取。代理將收到 permission_denied 錯誤，並可改為透過深層連結為你引導。"
          }
        }
      }
    },
    "When enabled, %@ (or device passcode) is required every time you open the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, ist bei jedem Öffnen der App %@ (oder der Gerätecode) erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, %@ (or device passcode) is required every time you open the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activé, %@ (ou le code de l'appareil) est requis à chaque ouverture de l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、アプリを開くたびに %@（またはデバイスのパスコード）が必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하면 앱을 열 때마다 %@(또는 기기 암호)가 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда включено, %@ (или код-пароль устройства) требуется при каждом открытии приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，每次打开应用都需要 %@（或设备密码）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，每次開啟應用程式都需要 %@（或裝置密碼）。"
          }
        }
      }
    },
    "When enabled, all console output is captured to daily log files.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden alle Konsolenausgaben in täglichen Logdateien gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, all console output is captured to daily log files."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'activé, toutes les sorties console sont enregistrées dans des fichiers journaliers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、すべてのコンソール出力が日別のログファイルに記録されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 모든 콘솔 출력이 일별 로그 파일에 기록됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда включено, весь вывод консоли записывается в ежедневные файлы логов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，所有控制台输出将被记录到每日日志文件中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啓用後，所有控制檯輸出將被記錄到每日日誌文件中。"
          }
        }
      }
    },
    "When enabled, any environment variable value that appears in shell-execute output is replaced with a masked form (e.g. `sk-1********ajhks`) before reaching the model. Values shorter than 8 characters become all `*`. The user-visible output in chat is unchanged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden in der Ausgabe von shell-execute erkannte Werte von Umgebungsvariablen vor der Weitergabe an das Modell maskiert (z. B. `sk-1********ajhks`). Werte mit weniger als 8 Zeichen werden vollständig durch `*` ersetzt. Die für den Nutzer sichtbare Ausgabe im Chat bleibt unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, any environment variable value that appears in shell-execute output is replaced with a masked form (e.g. `sk-1********ajhks`) before reaching the model. Values shorter than 8 characters become all `*`. The user-visible output in chat is unchanged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est activée, toute valeur de variable d'environnement détectée dans la sortie de shell-execute est masquée (p. ex. `sk-1********ajhks`) avant d'être transmise au modèle. Les valeurs de moins de 8 caractères sont entièrement remplacées par des `*`. La sortie visible dans le chat reste inchangée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、shell-execute の出力に含まれる環境変数の値はモデルに渡される前にマスクされます（例: `sk-1********ajhks`）。8 文字未満の値はすべて `*` に置き換えられます。チャットに表示される出力は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 shell-execute 출력에 나타난 환경 변수 값이 모델로 전달되기 전에 마스킹됩니다(예: `sk-1********ajhks`). 8자 미만의 값은 모두 `*` 로 바뀝니다. 채팅에 표시되는 출력은 그대로 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда включено, любое значение переменной окружения, появляющееся в выводе shell-execute, заменяется замаскированной формой (например, `sk-1********ajhks`) до того, как достигнет модели. Значения короче 8 символов превращаются полностью в `*`. Видимый пользователю вывод в чате не меняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，shell-execute 输出中检测到的环境变量值在送达模型前会被打码（例如 `sk-1********ajhks`）。少于 8 个字符的值会被全部替换为 `*`。聊天中用户可见的输出保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，shell-execute 輸出中偵測到的環境變數值會在送達模型前被打碼（例如 `sk-1********ajhks`）。少於 8 個字元的值會被全部替換為 `*`。聊天中使用者可見的輸出維持不變。"
          }
        }
      }
    },
    "When enabled, console and shell output is captured to daily files. Privacy Mode masks known environment-variable values, but logs can still contain file paths and task details. Review before sharing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn diese Option aktiviert ist, wird die Konsolen- und Shell-Ausgabe in täglichen Dateien erfasst. Der Datenschutzmodus maskiert bekannte Umgebungsvariablenwerte, Protokolle können jedoch weiterhin Dateipfade und Aufgabendetails enthalten. Überprüfen Sie es, bevor Sie es teilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'elle est activée, la sortie de la console et du shell est capturée dans des fichiers quotidiens. Le mode de confidentialité masque les valeurs connues des variables d'environnement, mais les journaux peuvent toujours contenir des chemins de fichiers et des détails sur les tâches. Révisez avant de partager."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、コンソールとシェルの出力が毎日のファイルにキャプチャされます。プライバシー モードでは既知の環境変数値がマスクされますが、ログにはファイル パスやタスクの詳細が含まれる可能性があります。共有する前に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화되면 콘솔 및 셸 출력이 일일 파일에 캡처됩니다. 개인 정보 보호 모드는 알려진 환경 변수 값을 마스크하지만 로그에는 파일 경로와 작업 세부 정보가 계속 포함될 수 있습니다. 공유하기 전에 검토하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если этот параметр включен, выходные данные консоли и оболочки сохраняются в ежедневные файлы. Режим конфиденциальности маскирует известные значения переменных среды, но журналы по-прежнему могут содержать пути к файлам и сведения о задачах. Просмотрите, прежде чем поделиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，控制台和 shell 输出将被捕获到日常文件中。隐私模式会屏蔽已知的环境变量值，但日志仍然可以包含文件路径和任务详细信息。分享前先回顾一下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，控制台和 shell 輸出將被捕獲到日常文件中。隱私模式會屏蔽已知的環境變數值，但日誌仍可包含檔案路徑和任務詳細資訊。分享前先回顧一下。"
          }
        }
      }
    },
    "When enabled, locked sessions require %@ (or device passcode) before their contents are revealed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, erfordern gesperrte Sitzungen %@ (oder den Gerätecode), bevor ihr Inhalt angezeigt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, locked sessions require %@ (or device passcode) before their contents are revealed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activé, les sessions verrouillées exigent %@ (ou le code de l'appareil) avant d'afficher leur contenu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、ロックされたセッションは内容を表示する前に %@（またはデバイスのパスコード）を要求します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하면 잠긴 세션은 내용을 표시하기 전에 %@(또는 기기 암호)가 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда включено, для показа содержимого заблокированных сессий требуется %@ (или код-пароль устройства)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，被锁定的会话需要 %@（或设备密码）才能查看其内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，鎖定的會話在顯示內容前需要 %@（或裝置密碼）。"
          }
        }
      }
    },
    "When enabled, waits for the AI to finish and returns the full response for use in subsequent actions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, wird auf die Fertigstellung der KI gewartet und die vollständige Antwort für nachfolgende Aktionen zurückgegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, waits for the AI to finish and returns the full response for use in subsequent actions."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque activé, attend que l'IA termine et retourne la réponse complète pour les actions suivantes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、AIの完了を待ち、後続のアクションで使用する完全な応答を返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 AI가 완료될 때까지 기다린 후 후속 작업에 사용할 전체 응답을 반환합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда включено, ожидает завершения ответа ИИ и возвращает полный ответ для использования в последующих действиях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，等待 AI 完成并返回完整响应，供后续操作使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啓用後，等待 AI 完成並返回完整響應，供後續操作使用。"
          }
        }
      }
    },
    "When enabled, waits for the AI to finish and returns the full response. Use this to chain the result into subsequent Shortcuts actions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, wird auf die Fertigstellung der KI gewartet und die vollständige Antwort zurückgegeben. Verwenden Sie dies, um das Ergebnis in nachfolgende Kurzbefehl-Aktionen zu verketten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, waits for the AI to finish and returns the full response. Use this to chain the result into subsequent Shortcuts actions."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque activé, attend que l'IA termine et retourne la réponse complète. Utilisez ceci pour chaîner le résultat dans les actions Raccourcis suivantes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、AIの完了を待ち、完全な応答を返します。結果を後続のショートカットアクションに連結するために使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 AI가 완료될 때까지 기다린 후 전체 응답을 반환합니다. 결과를 후속 단축어 작업에 연결하려면 이 옵션을 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда включено, ожидает завершения ответа ИИ и возвращает полный ответ. Используйте это, чтобы передать результат в последующие действия Команд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，等待 AI 完成并返回完整响应。使用此选项将结果传递到后续快捷指令操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啓用後，等待 AI 完成並返回完整響應。使用此選項將結果傳遞到後續快捷指令操作。"
          }
        }
      }
    },
    "When enabled, your manual fixes to voice transcripts (original → corrected pairs), accepted/rejected AI corrections, and frequently typed terms are stored in a local on-device database to make future voice corrections smarter. Nothing is uploaded. Default is off; existing data stays until you clear it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden Ihre manuellen Transkript-Korrekturen (Original → korrigiert), angenommene/abgelehnte KI-Korrekturen und häufig getippte Begriffe in einer lokalen Datenbank auf dem Gerät gespeichert, um künftige Sprachkorrekturen zu verbessern. Es wird nichts hochgeladen. Standardmäßig deaktiviert; vorhandene Daten bleiben, bis Sie sie löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, your manual fixes to voice transcripts (original → corrected pairs), accepted/rejected AI corrections, and frequently typed terms are stored in a local on-device database to make future voice corrections smarter. Nothing is uploaded. Default is off; existing data stays until you clear it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, vos corrections manuelles des transcriptions vocales (paires original → corrigé), les corrections IA acceptées/refusées et les termes fréquemment saisis sont enregistrés dans une base de données locale sur l'appareil afin d'améliorer les futures corrections vocales. Rien n'est envoyé en ligne. Désactivé par défaut ; les données existantes restent jusqu'à ce que vous les effaciez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、文字起こしへの手動修正(修正前→修正後のペア)、採用/却下された AI 修正、よく入力する語句が端末内のローカルデータベースに保存され、今後の音声修正の精度向上に使われます。データはアップロードされません。既定ではオフで、既存データは消去するまで残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 음성 인식에 대한 수동 수정(원본 → 수정 쌍), 채택/거부된 AI 교정, 자주 입력하는 용어가 기기 내 로컬 데이터베이스에 저장되어 향후 음성 교정을 더 똑똑하게 만듭니다. 어떤 데이터도 업로드되지 않습니다. 기본값은 꺼짐이며 기존 데이터는 지우기 전까지 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, ваши ручные правки транскрипции (пары «оригинал → исправлено»), принятые/отклонённые ИИ-коррекции и часто вводимые слова сохраняются в локальной базе данных на устройстве, чтобы улучшать будущие голосовые коррекции. Ничего не загружается в сеть. По умолчанию выключено; существующие данные сохраняются, пока вы их не удалите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后,你对语音转录的手动修改(原文 → 修正对)、采纳/拒绝的 AI 纠错、以及常用输入词汇会保存到设备本地数据库,用于让后续语音纠错更聪明。数据不会上传。默认关闭;已有数据在你清除前会一直保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後,你對語音轉錄的手動修改(原文 → 修正對)、採納/拒絕的 AI 糾錯、以及常用輸入詞彙會儲存到裝置本機資料庫,用於讓後續語音糾錯更聰明。資料不會上傳。預設關閉;既有資料在你清除前會一直保留。"
          }
        }
      }
    },
    "When iCloud Sync is enabled, LeoPhoneAgent syncs supported conversations, files, settings, and provider configuration through your private iCloud account. Provider credentials may be encoded in synchronized configuration; encoding is not encryption provided by LeoPhoneAgent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn iCloud Sync aktiviert ist, synchronisiert LeoPhoneAgent unterstützte Konversationen, Dateien, Einstellungen und Anbieterkonfiguration über Ihr privates iCloud-Konto. Anbieteranmeldeinformationen können in der synchronisierten Konfiguration codiert werden; Bei der Kodierung handelt es sich nicht um die von LeoPhoneAgent bereitgestellte Verschlüsselung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque iCloud Sync est activé, LeoPhoneAgent synchronise les conversations, les fichiers, les paramètres et la configuration du fournisseur pris en charge via votre compte privé iCloud. Les informations d'identification du fournisseur peuvent être codées dans une configuration synchronisée ; l'encodage n'est pas un cryptage fourni par LeoPhoneAgent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同期が有効になっている場合、LeoPhoneAgent は、プライベート iCloud アカウントを通じて、サポートされている会話、ファイル、設定、プロバイダー構成を同期します。プロバイダーの資格情報は、同期された構成でエンコードされる場合があります。エンコーディングは、LeoPhoneAgent によって提供される暗号化ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화가 활성화되면 LeoPhoneAgent은 개인 iCloud 계정을 통해 지원되는 대화, 파일, 설정 및 공급자 구성을 동기화합니다. 공급자 자격 증명은 동기화된 구성으로 인코딩될 수 있습니다. 인코딩은 LeoPhoneAgent에서 제공하는 암호화가 아닙니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда синхронизация iCloud включена, LeoPhoneAgent синхронизирует поддерживаемые разговоры, файлы, настройки и конфигурацию поставщика через вашу личную учетную запись iCloud. Учетные данные поставщика могут быть закодированы в синхронизированной конфигурации; кодировка не является шифрованием, предоставляемым LeoPhoneAgent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 iCloud 同步后，LeoPhoneAgent 通过您的私人 iCloud 帐户同步支持的对话、文件、设置和提供商配置。提供者凭证可以在同步配置中进行编码；编码不是 LeoPhoneAgent 提供的加密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用 iCloud 同步後，LeoPhoneAgent 透過您的私人 iCloud 帳戶同步支援的對話、檔案、設定和提供者設定。提供者憑證可以在同步配置中進行編碼；編碼不是 LeoPhoneAgent 提供的加密。"
          }
        }
      }
    },
    "When In Use": {
      "comment": "Location permission status",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Verwendung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When In Use"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cours d'utilisation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中のみ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중일 때"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При использовании"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用期间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用期間"
          }
        }
      }
    },
    "When off, the iSH shell and AI tools cannot create, edit, or delete files in this mount.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deaktiviert, können die iSH-Shell und KI-Tools keine Dateien in diesem Mount erstellen, bearbeiten oder löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, the iSH shell and AI tools cannot create, edit, or delete files in this mount."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque désactivé, le shell iSH et les outils IA ne peuvent pas créer, modifier ou supprimer des fichiers dans ce point de montage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、LeoPhoneAgent Shell と AI ツールはこのマウント内のファイルを作成・編集・削除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼져 있으면 LeoPhoneAgent Shell과 AI 도구는 이 마운트의 파일을 만들거나 편집하거나 삭제할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда выключено, оболочка iSH и инструменты ИИ не могут создавать, изменять или удалять файлы в этой точке монтирования."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，LeoPhoneAgent Shell 和 AI 工具将无法在此挂载中创建、编辑或删除文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，LeoPhoneAgent Shell 和 AI 工具將無法在此掛載中創建、編輯或刪除文件。"
          }
        }
      }
    },
    "When on, a new thinking block expands automatically while the model is reasoning and collapses when it finishes. When off, thinking blocks stay collapsed — tap one to read it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, wird ein neuer Denkblock automatisch aufgeklappt, während das Modell nachdenkt, und wieder eingeklappt, sobald es fertig ist. Wenn deaktiviert, bleiben Denkblöcke eingeklappt — zum Lesen antippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, a new thinking block expands automatically while the model is reasoning and collapses when it finishes. When off, thinking blocks stay collapsed — tap one to read it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, un nouveau bloc de réflexion se déploie automatiquement pendant que le modèle réfléchit et se replie une fois terminé. Si désactivé, les blocs de réflexion restent repliés — touchez-en un pour le lire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、モデルが推論している間、新しい思考ブロックが自動的に展開され、完了すると折りたたまれます。オフの場合、思考ブロックは折りたたまれたまま — タップすると読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 모델이 추론하는 동안 새 사고 블록이 자동으로 펼쳐지고 완료되면 접힙니다. 끄면 사고 블록이 접힌 상태로 유지되며, 탭하면 읽을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, новый блок размышлений автоматически разворачивается, пока модель рассуждает, и сворачивается по завершении. Если выключено, блоки размышлений остаются свёрнутыми — нажмите, чтобы прочитать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，模型推理时新的思考块会自动展开，完成后自动折叠。关闭后，思考块保持折叠——点击即可阅读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，模型推理時新的思考區塊會自動展開，完成後自動摺疊。關閉後，思考區塊保持摺疊——點一下即可閱讀。"
          }
        }
      }
    },
    "When on, the keyboard pops up automatically after the model finishes replying so the input is ready for a follow-up. On by default; turn off if you prefer to read the response without an unexpected keyboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, wird die Tastatur automatisch eingeblendet, sobald das Modell mit der Antwort fertig ist, sodass die Eingabe für eine Anschlussfrage bereit ist. Standardmäßig aktiviert; deaktiviere es, wenn du die Antwort ohne unerwartete Tastatur lesen möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the keyboard pops up automatically after the model finishes replying so the input is ready for a follow-up. On by default; turn off if you prefer to read the response without an unexpected keyboard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque activé, le clavier apparaît automatiquement une fois que le modèle a fini de répondre, afin que la saisie soit prête pour une question de suivi. Activé par défaut ; désactive-le si tu préfères lire la réponse sans clavier inattendu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、モデルの返信が完了した後にキーボードが自動的に表示され、続けて入力できる状態になります。デフォルトでオン。予期しないキーボードなしで返信を読みたい場合はオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 모델이 답변을 마친 후 키보드가 자동으로 나타나 후속 입력을 바로 할 수 있습니다. 기본값은 켜짐이며, 예기치 않은 키보드 없이 답변을 읽고 싶으면 끄세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда включено, клавиатура появляется автоматически после того, как модель закончит отвечать, чтобы поле ввода было готово для следующего вопроса. Включено по умолчанию; отключите, если предпочитаете читать ответ без неожиданной клавиатуры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，模型回复完成后会自动弹出键盘，方便继续追问。默认开启；若你希望在阅读回复时不被意外弹出的键盘打扰，可关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，模型回覆完成後會自動彈出鍵盤，方便繼續追問。預設開啟；若你希望在閱讀回覆時不被意外彈出的鍵盤打擾，可關閉。"
          }
        }
      }
    },
    "When you approve a native capability, the agent may read or change the requested data. For example, Photos can find, organize, save, or delete items, and Calendar can read or create events.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie eine native Funktion genehmigen, kann der Agent die angeforderten Daten lesen oder ändern. Fotos können beispielsweise Elemente finden, organisieren, speichern oder löschen und Kalender kann Ereignisse lesen oder erstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous approuvez une fonctionnalité native, l'agent peut lire ou modifier les données demandées. Par exemple, Photos peut rechercher, organiser, enregistrer ou supprimer des éléments, et Calendrier peut lire ou créer des événements."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ機能を承認すると、エージェントは要求されたデータを読み取りまたは変更することがあります。たとえば、写真ではアイテムの検索、整理、保存、削除が可能で、カレンダーではイベントの読み取りまたは作成が可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 기능을 승인하면 에이전트가 요청된 데이터를 읽거나 변경할 수 있습니다. 예를 들어 포토에서는 항목을 찾고, 정리하고, 저장하거나 삭제할 수 있고, 캘린더에서는 일정을 읽거나 만들 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы утверждаете встроенную возможность, агент может прочитать или изменить запрошенные данные. Например, «Фото» может находить, упорядочивать, сохранять или удалять элементы, а «Календарь» — читать или создавать события."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您批准本机功能时，代理可以读取或更改请求的数据。例如，照片可以查找、组织、保存或删除项目，日历可以读取或创建事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當您批准本機功能時，代理程式可以讀取或變更要求的資料。例如，照片可以尋找、組織、儲存或刪除項目，日曆可以讀取或建立事件。"
          }
        }
      }
    },
    "Where data goes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohin die Daten gehen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où vont les données"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データの行き先"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터가 가는 곳"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Куда идут данные"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据去向"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數據去向"
          }
        }
      }
    },
    "Which message do you want to retry from?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab welcher Nachricht möchten Sie es erneut versuchen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which message do you want to retry from?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir de quel message souhaitez-vous réessayer ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのメッセージから再試行しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 메시지부터 다시 시도하시겠어요?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С какого сообщения вы хотите повторить?"
          }
        },
        "zh-Hans": {
