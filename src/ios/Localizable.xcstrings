        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "/root 디렉토리를 백업한 후 rootfs를 초기화합니다. 나중에 백업을 복원할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет создана резервная копия вашей папки /root, после чего rootfs будет сброшен. Резервную копию можно восстановить позже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
