    "About %lld local records will upload to iCloud. Estimated time ~%lld hr depending on iCloud throttling. You can pause or cancel any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungefähr %lld lokale Datensätze werden auf iCloud hochgeladen. Geschätzte Zeit ~%lld Stunden, abhängig von der iCloud Drosselung. Sie können jederzeit pausieren oder abbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "About %1$lld local records will upload to iCloud. Estimated time ~%2$lld hr depending on iCloud throttling. You can pause or cancel any time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %lld enregistrements locaux seront téléchargés vers iCloud. Temps estimé ~%lld heure en fonction de la limitation de iCloud. Vous pouvez suspendre ou annuler à tout moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約 %lld 個のローカル レコードが iCloud にアップロードされます。推定時間は、iCloud スロットルに応じて ~%lld 時間です。いつでも一時停止またはキャンセルできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 정보 로컬 기록은 iCloud에 업로드됩니다. iCloud 조절에 따라 예상 시간은 ~%lld시간입니다. 언제든지 일시중지하거나 취소할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Около %lld локальные записи будут загружены в iCloud. Расчетное время ~%lld час в зависимости от регулирования iCloud. Вы можете приостановить или отменить действие в любое время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 %1$lld 条本地记录将上传至 iCloud。预计耗时 ~%2$lld 小时（受 iCloud 限流影响）。可随时暂停或取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於%lld本機記錄將上傳至iCloud。預計時間 ~%lld 小時，取決於 iCloud 節流。您可以隨時暫停或取消。"
          }
        }
      }
    },
