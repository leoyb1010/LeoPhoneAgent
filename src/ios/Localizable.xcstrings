    },
    "Cleared entries can no longer be reverted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleared entries can no longer be reverted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空后这些记录将无法再回滚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清空後這些紀錄將無法再還原。"
          }
        }
      }
    },
    "Contact names, phone numbers, emails, and groups": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人姓名、电话、邮箱和分组"
          }
        }
      }
    },
    "Continue across personal devices": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的其他设备上接着用"
          }
        }
      }
    },
    "Continue user-started Agent work after locking": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏后继续你发起的 Agent 任务"
          }
        }
      }
    },
    "Continues from the interruption point already saved in this conversation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这个对话里已保存的中断点继续。"
          }
        }
      }
    },
    "Conversations, attachments, agent workspaces, and settings are stored in the app container.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话、附件、Agent 工作区和设置都存在 App 自己的目录里。"
          }
        }
      }
    },
    "Could not renew the %@ sign-in right now. Check your connection and try again.": {
      "localizations": {
        "zh-Hans": {
