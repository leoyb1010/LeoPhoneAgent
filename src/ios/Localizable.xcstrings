    "This shows the current system authorization and never triggers a permission prompt. “Not asked” means iOS will request it the first time the Agent uses this capability.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里显示的是系统授权状态，不会触发授权弹窗。「未询问」表示该能力首次被 Agent 用到时才会向你请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡顯示的是系統授權狀態，不會觸發授權彈窗。「未詢問」表示該能力首次被 Agent 用到時才會向你請求。"
          }
        }
      }
    },
