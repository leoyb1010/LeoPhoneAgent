        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为符合 25MB 上限，已从请求中省略较早的 %lld 张图片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為符合 25MB 上限，已從請求中省略較早的 %lld 張圖片"
          }
        }
      }
    },
