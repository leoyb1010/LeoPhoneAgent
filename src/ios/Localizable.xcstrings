      }
    },
    "This removes the artifact and every local version. This action cannot be undone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除该产出文件及其全部本地版本，且无法撤销。"
          }
