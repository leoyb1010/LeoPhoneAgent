          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LeoPhoneAgent에게 무엇을 물어보시겠어요?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О чём вы хотите спросить LeoPhoneAgent?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
