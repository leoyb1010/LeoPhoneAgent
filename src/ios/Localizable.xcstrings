    },
    "This will delete all local messages for this chat and re-download them from iCloud. Local changes that haven't synced yet will be lost. Continue?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete all local messages for this chat and re-download them from iCloud. Local changes that haven't synced yet will be lost. Continue?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除此对话本地的所有消息并从 iCloud 重新下载。尚未同步的本地修改会丢失。继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除此對話本地的所有訊息並從 iCloud 重新下載。尚未同步的本地修改會遺失。是否繼續？"
          }
        }
      }
    },
    "This will delete the entire rootfs. All data will be lost. The app will need to restart to reinstall.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete the entire rootfs. All data will be lost. The app will need to restart to reinstall."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除整个 rootfs，所有数据将丢失。需要重启应用以重新安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將刪除整個 rootfs，所有數據將丟失。需要重啓應用以重新安裝。"
          }
        }
      }
    },
    "This will delete the entire rootfs. All data will be lost. The app will need to restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
