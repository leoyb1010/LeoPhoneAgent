            "value": "What would you like to ask LeoPhoneAgent?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que souhaitez-vous demander à LeoPhoneAgent ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
