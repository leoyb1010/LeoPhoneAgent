    "This group drives Voice Input — only models that accept audio input are listed.": {
      "comment": "Add-models filter note for the bound voice input group",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gruppe steuert die Spracheingabe – es werden nur Modelle aufgeführt, die Audioeingaben akzeptieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This group drives Voice Input — only models that accept audio input are listed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce groupe pilote l’entrée vocale — seuls les modèles acceptant une entrée audio sont listés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループは音声入力を制御します — 音声入力を受け付けるモデルのみが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹은 음성 입력을 담당합니다 — 오디오 입력을 지원하는 모델만 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта группа управляет голосовым вводом — показаны только модели, принимающие аудиовход."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分组用于语音输入 — 仅列出接受音频输入的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此分組用於語音輸入 — 僅列出接受音訊輸入的模型。"
          }
        }
      }
    },
    "This group drives Voice Output — only models that can output audio are listed.": {
      "comment": "Add-models filter note for the bound voice output group",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gruppe steuert die Sprachausgabe – es werden nur Modelle aufgeführt, die Audio ausgeben können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This group drives Voice Output — only models that can output audio are listed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce groupe pilote la sortie vocale — seuls les modèles capables de produire de l’audio sont listés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループは音声出力を制御します — 音声を出力できるモデルのみが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹은 음성 출력을 담당합니다 — 오디오를 출력할 수 있는 모델만 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта группа управляет голосовым выводом — показаны только модели, способные выводить аудио."
          }
