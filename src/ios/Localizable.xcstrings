    "Sends a follow-up prompt to an existing LeoPhoneAgent session, continuing the conversation with the AI agent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet einen Folgeprompt an eine bestehende LeoPhoneAgent-Sitzung und setzt das Gespräch mit dem KI-Agenten fort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a follow-up prompt to an existing LeoPhoneAgent session, continuing the conversation with the AI agent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie un prompt de suivi à une session LeoPhoneAgent existante, poursuivant la conversation avec l'agent IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存の LeoPhoneAgent セッションにフォローアッププロンプトを送信し、AIエージェントとの会話を続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 LeoPhoneAgent 세션에 후속 프롬프트를 보내 AI 에이전트와의 대화를 계속합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет дополнительный запрос в существующую сессию LeoPhoneAgent, продолжая диалог с AI-агентом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向现有 LeoPhoneAgent 会话发送跟进提示，继续与 AI 代理的对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向現有 LeoPhoneAgent 會話發送跟進提示，繼續與 AI 代理的對話。"
          }
        }
      }
    },
    "Sends a prompt to the LeoPhoneAgent AI agent. Returns session info immediately while the task runs in the background.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet einen Prompt an den LeoPhoneAgent-KI-Agenten. Gibt Sitzungsinformationen sofort zurück, während die Aufgabe im Hintergrund läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a prompt to the LeoPhoneAgent AI agent. Returns session info immediately while the task runs in the background."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie un prompt à l'agent IA LeoPhoneAgent. Retourne les informations de session immédiatement pendant que la tâche s'exécute en arrière-plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LeoPhoneAgent AI エージェントにプロンプトを送信します。タスクがバックグラウンドで実行される間、セッション情報を即座に返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LeoPhoneAgent AI 에이전트에 프롬프트를 보냅니다. 작업이 백그라운드에서 실행되는 동안 세션 정보를 즉시 반환합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет запрос AI-агенту LeoPhoneAgent. Сразу возвращает информацию о сессии, пока задача выполняется в фоне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 LeoPhoneAgent AI 代理发送提示。任务在后台运行时立即返回会话信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向 LeoPhoneAgent AI 代理發送提示。任務在後臺運行時立即返回會話信息。"
          }
        }
      }
    },
