    "Primary": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Primär"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Primary"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Principal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライマリ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основная"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主模型"
          }
        }
      }
    },
    "Primary is used for main agent tasks. Sub is used for lightweight tasks like title generation. If Sub is not set, it inherits from Primary.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Primär wird für Hauptaufgaben verwendet. Sub für leichte Aufgaben wie Titelgenerierung. Wenn Sub nicht gesetzt ist, wird Primär übernommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Primary is used for main agent tasks. Sub is used for lightweight tasks like title generation. If Sub is not set, it inherits from Primary."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le principal est utilisé pour les tâches principales. Le secondaire pour les tâches légères comme la génération de titres. S'il n'est pas défini, il hérite du principal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライマリはメインタスクに使用されます。サブはタイトル生成などの軽量タスクに使用されます。サブが未設定の場合はプライマリが継承されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주요 모델은 주요 에이전트 작업에, 보조 모델은 제목 생성 등 가벼운 작업에 사용됩니다. 보조가 미설정이면 주요를 상속합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основная используется для главных задач Agent. Дополнительная используется для лёгких задач, например генерации заголовков. Если дополнительная не задана, она наследуется от основной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主模型用于主要任务，辅助模型用于标题生成等轻量任务。未设置辅助模型时将继承主模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主模型用於主要任務，輔助模型用於標題生成等輕量任務。未設置輔助模型時將繼承主模型。"
          }
        }
      }
    },
    "Primary is used for main agent tasks. Sub is used for lightweight tasks like title generation. Voice Input/Output pick a group whose audio-capable models drive speech-to-text and text-to-speech; if none is set, the offline System voice is used.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Primär wird für die Hauptaufgaben des Agenten verwendet. Sub wird für leichtgewichtige Aufgaben wie die Titelgenerierung verwendet. Spracheingabe/-ausgabe wählen eine Gruppe, deren audiofähige Modelle Sprache-zu-Text und Text-zu-Sprache antreiben; ist keine gesetzt, wird die offline System-Stimme verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Primary is used for main agent tasks. Sub is used for lightweight tasks like title generation. Voice Input/Output pick a group whose audio-capable models drive speech-to-text and text-to-speech; if none is set, the offline System voice is used."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle principal sert aux tâches principales de l’agent. Le modèle secondaire sert aux tâches légères comme la génération de titres. Entrée/Sortie vocale choisissent un groupe dont les modèles audio assurent la reconnaissance et la synthèse vocale ; si aucun n’est défini, la voix système hors ligne est utilisée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライマリはエージェントの主なタスクに使われます。サブはタイトル生成などの軽量タスクに使われます。音声入力/出力は、音声対応モデルが音声認識と音声合成を担うグループを選びます。未設定の場合はオフラインのシステム音声が使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본은 주요 에이전트 작업에 사용됩니다. 보조는 제목 생성 같은 가벼운 작업에 사용됩니다. 음성 입력/출력은 오디오 지원 모델이 음성 인식과 음성 합성을 수행하는 그룹을 선택합니다. 설정하지 않으면 오프라인 시스템 음성이 사용됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основная используется для главных задач агента. Дополнительная — для лёгких задач, например генерации заголовков. Голосовой ввод/вывод выбирают группу, чьи аудиомодели обеспечивают распознавание и синтез речи; если не задано, используется офлайн системный голос."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主模型用于智能体的主要任务。副模型用于标题生成等轻量任务。语音输入/输出会选择一个分组,由其支持音频的模型驱动语音转文字和文字转语音;若未设置,则使用离线的系统语音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主模型用於智能體的主要任務。副模型用於標題生成等輕量任務。語音輸入/輸出會選擇一個分組,由其支援音訊的模型驅動語音轉文字和文字轉語音;若未設定,則使用離線的系統語音。"
          }
        }
      }
    },
