    "Clear your custom display name and max output tokens, restoring the values reported by the provider.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen Sie Ihren benutzerdefinierten Anzeigenamen und die maximale Ausgabe Token und stellen Sie die vom Anbieter gemeldeten Werte wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear your custom display name and max output tokens, restoring the values reported by the provider."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacez votre nom d'affichage personnalisé et la sortie maximale Token, en restaurant les valeurs signalées par le fournisseur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム表示名と最大出力 Token をクリアし、プロバイダーによって報告された値を復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 정의 표시 이름과 최대 출력 Token을 지워 공급자가 보고한 값을 복원합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистите свое пользовательское отображаемое имя и максимальный вывод Token, восстановив значения, предоставленные поставщиком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除您的自定义显示名称和最大输出 Token，恢复提供程序报告的值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除您的自訂顯示名稱和最大輸出 Token，恢復提供者報告的值。"
          }
        }
      }
    },
    "Clear your customizations and restore the values reported by the provider.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche deine Anpassungen und stelle die vom Anbieter gemeldeten Werte wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear your customizations and restore the values reported by the provider."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface tes personnalisations et restaure les valeurs indiquées par le fournisseur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタマイズをクリアし、プロバイダーが報告した値を復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
