    "This will clear all customizations (including force-enabled thinking) and restore the provider's default values.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Anpassungen (einschließlich erzwungenem Denkmodus) werden gelöscht und die Standardwerte des Anbieters wiederhergestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will clear all customizations (including force-enabled thinking) and restore the provider's default values."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela effacera toutes les personnalisations (y compris la réflexion forcée) et restaurera les valeurs par défaut du fournisseur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのカスタマイズ（強制有効化した思考を含む）がクリアされ、プロバイダのデフォルト値に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사용자 정의(강제 활성화된 사고 포함)가 삭제되고 제공자의 기본값으로 복원됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все настройки (включая принудительно включённый режим мышления) будут сброшены, и восстановлены значения провайдера по умолчанию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将清除所有自定义设置（包括强制开启的深度思考），恢复为服务商默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將清除所有自訂設定（包括強制開啟的深度思考），恢復為服務商預設值。"
          }
        }
      }
    },
    "This will delete %@ of files. This action cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden %@ an Dateien gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete %@ of files. This action cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera %@ de fichiers. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のファイルが削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 파일이 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет удалено файлов на %@. Это действие нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除 %@ 的文件。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將刪除 %@ 的文件。此操作無法撤銷。"
          }
        }
      }
    },
    "This will delete %@ of log files. This action cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden %@ an Protokolldateien gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete %@ of log files. This action cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera %@ de fichiers journaux. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のログファイルが削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 로그 파일이 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "ru": {
