    },
    "What would you like to ask LeoPhoneAgent?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was möchten Sie LeoPhoneAgent fragen?"
          }
        },
        "en": {
          "stringUnit": {
