        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを使うとフォールバックや負荷分散のためにモデルを組み合わせられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹을 사용하면 대체 또는 로드 밸런싱을 위해 모델을 결합할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
