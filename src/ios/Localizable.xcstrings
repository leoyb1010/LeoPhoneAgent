          "stringUnit": {
            "state": "translated",
            "value": "清除你的自訂設定並還原服務商回報的值。"
          }
        }
      }
    },
    "Clearing cookies will sign you out of all websites in the LeoPhoneAgent browser.": {
      "localizations": {
