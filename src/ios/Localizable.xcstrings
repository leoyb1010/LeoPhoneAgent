        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All LeoBot data has been removed from iCloud. This device is now re-uploading its local content to a fresh iCloud zone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 LeoBot 数据已从 iCloud 中移除。本设备正在将其本地内容重新上传到新的 iCloud 区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 LeoBot 數據已從 iCloud 中移除。本設備正在將其本地內容重新上傳到新的 iCloud 區域。"
          }
