    "A personal iOS agent that runs tools on your device and connects to the AI providers you choose.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein persönlicher iOS-Agent, der Tools auf Ihrem Gerät ausführt und eine Verbindung zu den von Ihnen ausgewählten KI-Anbietern herstellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent iOS personnel qui exécute des outils sur votre appareil et se connecte aux fournisseurs d'IA de votre choix."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上でツールを実行し、選択した AI プロバイダーに接続する個人の iOS エージェント。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 장치에서 도구를 실행하고 귀하가 선택한 AI 제공업체에 연결하는 개인 iOS 에이전트입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Персональный агент iOS, который запускает инструменты на вашем устройстве и подключается к выбранным вами поставщикам ИИ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人 iOS 代理，在您的设备上运行工具并连接到您选择的 AI 提供商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "個人 iOS 代理，在您的裝置上執行工具並連接到您選擇的 AI 提供者。"
          }
        }
      }
    },
