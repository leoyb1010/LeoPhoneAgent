"Continue a ${applicationName} session" = "继续${applicationName}会话";
"Open a ${applicationName} session" = "打开${applicationName}会话";

/* [T-siri-fleet] Mac 舰队四件套 */
"Command a Mac with ${applicationName}" = "用${applicationName}指挥Mac";
"Ask ${applicationName} to command a Mac" = "让${applicationName}指挥一台Mac";
"${applicationName} fleet report" = "${applicationName}汇报";
"Ask ${applicationName} for a report" = "让${applicationName}汇报工作";
"Check ${applicationName} Macs" = "查看${applicationName}的Mac";
"Approve with ${applicationName}" = "${applicationName}批准";
"${applicationName} approve" = "让${applicationName}批准";
"Stop a Mac task with ${applicationName}" = "让${applicationName}停止Mac任务";

/* [T-siri-short] 短口语(配合别名 LPA:问LPA / 让LPA干活 / LPA停) */
"Hey ${applicationName}" = "问${applicationName}";
"${applicationName} get to work" = "让${applicationName}干活";
"${applicationName} stop" = "${applicationName}停止任务";

/* [T-collections] 收藏 */
"Collect with ${applicationName}" = "${applicationName}收藏";
"${applicationName} collect this" = "让${applicationName}收藏这个";
