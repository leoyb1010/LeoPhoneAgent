{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "store-cn-base": {
      "distribution": "store",
      "environment": "production",
      "node": "22.19.0",
      "ios": { "resourceClass": "m-medium" },
      "env": {
        "EXPO_PUBLIC_CINDY_AUTH_REGION": "cn",
        "XDT_SKIP_AGENT_BIN_INSTALL": "1"
      }
    },
    "testflight": {
      "extends": "store-cn-base",
      "channel": "production"
    },
    "production": {
      "extends": "store-cn-base",
      "channel": "production"
    },
    "store-global-base": {
      "distribution": "store",
      "environment": "production",
      "node": "22.19.0",
      "ios": { "resourceClass": "m-medium" },
      "env": {
        "EXPO_PUBLIC_CINDY_AUTH_REGION": "global",
        "XDT_SKIP_AGENT_BIN_INSTALL": "1"
      }
    },
    "testflight-global": {
      "extends": "store-global-base",
      "channel": "production-global"
    },
    "production-global": {
      "extends": "store-global-base",
      "channel": "production-global"
    },
    "adhoc": {
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "node": "22.19.0",
      "ios": { "resourceClass": "m-medium" },
      "env": {
        "EXPO_PUBLIC_CINDY_AUTH_REGION": "cn",
        "XDT_SKIP_AGENT_BIN_INSTALL": "1"
      }
    },
    "adhoc-global": {
      "extends": "adhoc",
      "channel": "staging-global",
      "env": {
        "EXPO_PUBLIC_CINDY_AUTH_REGION": "global"
      }
    }
  }
}
