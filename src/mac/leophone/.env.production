# [leo] LeoBot 不连接官方服务：正式环境的官方地址一律指向本机死端口，OAuth client id 置空。
# 这些值会被 vite / tsup 编进渲染层与主进程，不能写官方域名（scripts/leo-redline-check.mjs 会拦）。
ZCODE_PRODUCTION_BASE_URL=http://127.0.0.1:9
ZAI_PRODUCTION_OAUTH_ORIGIN=http://127.0.0.1:9
ZAI_PRODUCTION_BUSINESS_BASE_URL=http://127.0.0.1:9
ZAI_PRODUCTION_OAUTH_CLIENT_ID=
